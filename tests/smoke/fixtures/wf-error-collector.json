{
  "name": "kit-smoke-error-collector",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "__PATH__", "responseMode": "lastNode", "options": {} },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// Stands in for the alert channel: whatever the error handler posts here lands in this\n// execution's saved data, where the smoke suite can read it back through the public API.\nreturn [{ json: { collected: $input.first().json.body } }];"
      },
      "name": "Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Code", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveDataSuccessExecution": "all", "saveDataErrorExecution": "all" }
}
