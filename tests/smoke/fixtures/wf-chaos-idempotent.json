{
  "name": "kit-smoke-template",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "__PATH__", "responseMode": "onReceived", "options": {} },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body;\nreturn [{ json: { marker: `run=${b.run} id=${b.id} exec=${$execution.id}` } }];"
      },
      "name": "Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, 0]
    },
    {
      "parameters": { "operation": "toText", "sourceProperty": "marker", "binaryPropertyName": "data", "options": {} },
      "name": "Convert to File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [600, 0]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ '/home/node/.n8n-files/chaos-' + $('Webhook').item.json.body.run + '-' + $('Webhook').item.json.body.id + '.txt' }}",
        "dataPropertyName": "data",
        "options": {}
      },
      "name": "Write File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [900, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Code", "type": "main", "index": 0 }]] },
    "Code": { "main": [[{ "node": "Convert to File", "type": "main", "index": 0 }]] },
    "Convert to File": { "main": [[{ "node": "Write File", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
