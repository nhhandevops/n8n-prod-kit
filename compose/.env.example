# =================================================================================================
# n8n Production Kit — compose/.env.example  (S2 contract §5)
#
# `make init DOMAIN=...` copies this file to .env, fills the identity keys and generates the secrets.
# .env is chmod 600 and git-ignored: NEVER commit it. Every key below is read by docker-compose.yml
# (through `--env-file versions.env --env-file .env`); nobody invents a new key without adding it
# here first. Pinned image versions live in versions.env, not here.
#
# Syntax (Compose dotenv AND bash-compatible — scripts/lib.sh `load_env` sources this file):
#   KEY=value             plain values: no spaces, no quotes, no $, no #
#   KEY='va lue $x'       single quotes = literal (use them for anything with spaces, $ or #)
#   KEY="javascript python"   double quotes also work when the value has no $
# Comments on their own lines only (an inline "# ..." after a value is a Compose-only feature).
# =================================================================================================

# ---------------------------------------------------------------------------------------------
# 1 IDENTITY & EDGE
# ---------------------------------------------------------------------------------------------

# DOMAIN — the public host name users and webhooks reach (also the TLS certificate name).
# Default: n8n.example.com (placeholder; init overwrites it). Why: Caddy's site block is
# `{$DOMAIN}`, n8n sets N8N_HOST from it, and PUBLIC_URL is derived from it. Dev names such as
# *.localtest.me, *.local, *.test, *.internal, *.home.arpa, localhost or an IPv4 address make init
# pick TLS_MODE=internal because no public CA can issue for them.
DOMAIN=n8n.example.com

# TLS_MODE — how Caddy obtains the certificate: acme | acme-staging | internal.
#   acme          Let's Encrypt production (DOMAIN must resolve to this host on ports 80/443)
#   acme-staging  Let's Encrypt staging (untrusted certs, no rate limits — rehearse DNS/firewall)
#   internal      Caddy's own local CA (dev; `make trust-ca` installs the root; also adds
#                 compose.dev.yml so n8n trusts that CA and can call its own PUBLIC_URL)
# Default: acme. Why: selects the imported Caddy snippet tls-<mode>.caddy and the dev override file.
TLS_MODE=acme

# ACME_EMAIL — contact e-mail registered with the ACME CA (expiry warnings, ToS).
# Default: admin@example.com (placeholder; init requires a real one for public domains and writes
# dev@example.com for dev domains). Why: Caddy's global `email {$ACME_EMAIL}` must have a value even
# in internal mode (verified: Caddy refuses to start with it empty).
ACME_EMAIL=admin@example.com

# HTTP_PORT — host port Caddy publishes for plain HTTP (ACME HTTP-01 + the permanent redirect).
# Default: 80. Why: Caddy listens on the SAME number inside the container (`http_port {$HTTP_PORT}`),
# so on a dev host using 8080 the http->https redirect still carries the right port.
HTTP_PORT=80

# HTTPS_PORT — host port Caddy publishes for HTTPS (tcp) and HTTP/3 (udp).
# Default: 443. Why: same rule as HTTP_PORT; a non-443 value is appended to PUBLIC_URL by init.
HTTPS_PORT=443

# PUBLIC_URL — the full base URL of this instance, always with a trailing slash.
# Default: https://n8n.example.com/ — written by init as https://DOMAIN/ (or
# https://DOMAIN:HTTPS_PORT/ when HTTPS_PORT is not 443). Why: it feeds N8N_WEBHOOK_URL (the URL n8n
# prints in webhook nodes) and N8N_EDITOR_BASE_URL (links in e-mails, OAuth callbacks, SAML).
PUBLIC_URL=https://n8n.example.com/

# UI_PROTECT — extra protection in front of the n8n editor/API (NOT the webhook paths): off | on.
# Default: off. Why: when on, Caddy imports ui-protect-on.caddy: requests from outside
# UI_ALLOW_CIDR get 403 and everything else must pass HTTP basic auth before reaching the n8n login.
# Webhooks, forms and MCP endpoints are never affected, so integrations keep working.
UI_PROTECT=off

# UI_ALLOW_CIDR — space-separated CIDRs allowed to reach the UI when UI_PROTECT=on.
# Default: empty = "0.0.0.0/0 ::/0" (everyone, basic auth only). Example: '203.0.113.0/24 10.0.0.0/8'
# (quote it: it contains spaces). Why: deny-by-IP happens before the auth prompt (verified), so a
# VPN/office range can be the only one that even sees the login page. Mind Docker NAT: clients on
# the host itself appear as the docker bridge gateway (172.x.x.1).
UI_ALLOW_CIDR=

# UI_BASIC_AUTH_USER — the basic-auth user name for UI_PROTECT=on.
# Default: empty (required when UI_PROTECT=on, Caddy refuses to start otherwise).
UI_BASIC_AUTH_USER=

# UI_BASIC_AUTH_HASH — bcrypt hash of the basic-auth password, produced by
#   docker compose run --rm caddy caddy hash-password --plaintext 'your-password'
# Default: empty (required when UI_PROTECT=on).
# !!! QUOTING WARNING !!! The hash looks like $2a$14$F5ChMW... — every "$name" segment of an
# UNQUOTED or DOUBLE-QUOTED value is interpolated away by Compose (verified: $2a$14$F5Ch...
# became $2a$14.nOw..., silently, and the login never matched). You MUST write it either
# single-quoted:          UI_BASIC_AUTH_HASH='$2a$14$F5ChMWCL9FuTubLx0Z1.nOw90btPQPpHjdoyFx6ENIZrLPqvSwhHe'
# or with every $ doubled: UI_BASIC_AUTH_HASH=$$2a$$14$$F5ChMWCL9FuTubLx0Z1.nOw90btPQPpHjdoyFx6ENIZrLPqvSwhHe
# Single quotes are the form scripts/lib.sh env_set writes.
UI_BASIC_AUTH_HASH=

# KUMA_ENABLED — publish Uptime Kuma at kuma.DOMAIN through Caddy: off | on.
# Default: off. "on" goes together with the "kuma" profile in COMPOSE_PROFILES (group 7; preflight
# checks both). Why: Caddy imports kuma-<value>.caddy; in acme mode kuma.DOMAIN needs its own public
# DNS record or Caddy keeps retrying ACME for it; in internal mode the local CA mints a second cert.
KUMA_ENABLED=off

# GENERIC_TIMEZONE — the timezone n8n uses for Schedule/Cron triggers and date expressions.
# Default: Asia/Ho_Chi_Minh. Why: n8n would otherwise assume America/New_York; the runner sidecars
# receive the same value so Code nodes agree with the workflow.
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# TZ — the container OS timezone (log timestamps, `date` inside containers).
# Default: Asia/Ho_Chi_Minh (keep it equal to GENERIC_TIMEZONE unless you have a reason).
TZ=Asia/Ho_Chi_Minh

# ---------------------------------------------------------------------------------------------
# 2 SECRETS — generated by `make init`, file mode 600, never commit, never paste into tickets
# ---------------------------------------------------------------------------------------------

# N8N_ENCRYPTION_KEY — encrypts every credential stored in Postgres. 64 chars (48 random bytes,
# base64) from init. Default: empty (init refuses to leave it empty). Why: main, webhook and worker
# processes MUST share it (workers refuse to start without it, main would silently generate a
# different one). LOSING IT = EVERY STORED CREDENTIAL IS UNREADABLE — keep it in a password manager.
N8N_ENCRYPTION_KEY=

# POSTGRES_PASSWORD — password of the Postgres role `n8n` (database `n8n`). 48 hex chars from init.
# Default: empty. Why: used by the postgres container at first boot (initdb) AND by every n8n
# process (DB_POSTGRESDB_PASSWORD); changing it later means changing it inside Postgres too.
POSTGRES_PASSWORD=

# VALKEY_PASSWORD — `requirepass` of the Valkey (Redis-compatible) queue. 48 hex chars from init.
# Default: empty. Why: the queue carries execution payloads; Valkey is on the internal network only
# but still authenticates every client (n8n QUEUE_BULL_REDIS_PASSWORD, the healthcheck).
VALKEY_PASSWORD=

# N8N_RUNNERS_AUTH_TOKEN — shared secret between each worker's task broker (:5679) and its runner
# sidecar. 64 hex chars from init. Default: empty. Why: a sidecar with the wrong token stays
# silent for 60 s and exits 0 (verified) — the token must be identical on both sides, and if n8n
# had none it would generate a random one the sidecar could never match.
N8N_RUNNERS_AUTH_TOKEN=

# GRAFANA_ADMIN_PASSWORD — initial Grafana admin password (monitoring profile; login at
# https://DOMAIN/grafana/ as GRAFANA_ADMIN_USER). 24 hex chars from init. Default: empty.
GRAFANA_ADMIN_PASSWORD=

# GRAFANA_SECRET_KEY — encrypts the secrets Grafana stores in its database (e.g. the Telegram token of the contact
# point). 40 hex chars from init. Default: empty = Grafana's built-in default key. Set it only for a NEW Grafana:
# changing it later makes what Grafana already stored unreadable.
GRAFANA_SECRET_KEY=

# KUMA_ADMIN_USER / KUMA_ADMIN_PASSWORD — Uptime Kuma's admin (profile kuma). make up creates the account right after
# Kuma starts, so its first-run page is never open to whoever reaches kuma.DOMAIN first. Password: 32 hex chars from
# init (generated by make up when missing). Default user: admin.
KUMA_ADMIN_USER=admin
KUMA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------
# 3 TOPOLOGY & SIZING
# ---------------------------------------------------------------------------------------------

# WORKER_REPLICAS — number of n8n worker processes (1..16).
# Default: 2. Why: workers 1 and 2 are static in docker-compose.yml; `make render` writes
# compose.scale.yml with n8n-worker-3..N (each with its own runner sidecar) when the value is above
# 2 and removes that file when it is 2 or less. NOTE: with WORKER_REPLICAS=1 Compose still starts
# worker-2 in S2 (`make scale-workers` in S3 handles it with --scale/profiles).
WORKER_REPLICAS=2

# WORKER_CONCURRENCY — parallel executions per worker (`n8n worker --concurrency=N`).
# Default: 10 (n8n's own default). Why: n8n recommends >= 5; each running execution holds one of
# DB_POSTGRESDB_POOL_SIZE connections, so 16 workers x 10 x 4 is still below max_connections=150.
# Ignored when N8N_CONCURRENCY_PRODUCTION_LIMIT (group 4) is not -1.
WORKER_CONCURRENCY=10

# RUNNERS_LANGS — languages enabled in each runner sidecar; this is the sidecar's command line.
# Default: javascript. Set "javascript python" (quoted — two words) to enable native Python Code
# nodes. Why: there is no N8N_NATIVE_PYTHON_RUNNER variable in 2.x (verified); the launcher
# starts one runner per listed language, the Python one costs ~75 MiB extra per task.
RUNNERS_LANGS=javascript

# RUNNERS_MAX_CONCURRENCY — tasks one runner process executes in parallel.
# Default: 5 (the documented value; the code default is 10). Why: Code-node tasks are CPU-bound;
# keep it <= WORKER_CONCURRENCY and size MEM_LIMIT_RUNNERS at ~200 MiB per concurrent JS task.
RUNNERS_MAX_CONCURRENCY=5

# RUNNERS_TASK_TIMEOUT — seconds a single Code-node task may run (broker AND sidecar side).
# Default: 300 (n8n's broker default). Why: the launcher otherwise forces 60 s into the runners
# (verified), which kills long-running Code nodes; the kit sets both sides from this one knob.
RUNNERS_TASK_TIMEOUT=300

# MEM_LIMIT_* — cgroup memory limits per container (Compose deploy.resources.limits.memory; honoured
# without Swarm, verified). Units: m = MiB, g = GiB. Defaults fit a 4 GB host with WORKER_REPLICAS=2:
# 1g + 2x512m + 2x1g + 2x512m + 1g + 384m + 256m ~= 6.6 GB of LIMITS (real use is far lower; limits
# only cap runaway executions — a container that exceeds its limit is OOM-killed and restarted).
# Docker also allows up to the same amount again in swap when the host has swap (verified).

# MEM_LIMIT_MAIN — n8n-main (UI, API, triggers, migrations). Default: 1g. Why: manual runs are
# offloaded to the workers, so main stays small; migrations on a large DB are the peak.
MEM_LIMIT_MAIN=1g

# MEM_LIMIT_WEBHOOK — each n8n-webhook-N (they only enqueue jobs). Default: 512m.
MEM_LIMIT_WEBHOOK=512m

# MEM_LIMIT_WORKER — each n8n-worker-N (runs the executions). Default: 1g. Why: raise this first
# when executions handle big binaries or many parallel jobs (WORKER_CONCURRENCY).
MEM_LIMIT_WORKER=1g

# MEM_LIMIT_RUNNERS — each runner sidecar (Code-node sandboxes). Default: 512m. Why: ~200 MiB per
# concurrently running JS task (+75 MiB for Python); size with RUNNERS_MAX_CONCURRENCY.
MEM_LIMIT_RUNNERS=512m

# MEM_LIMIT_POSTGRES — the database. Default: 1g (shared_buffers is 256 MB; the rest is work_mem,
# connections and the OS page cache the cgroup accounts to the container).
MEM_LIMIT_POSTGRES=1g

# MEM_LIMIT_VALKEY — the queue. Default: 384m. Why: maxmemory is 256 MB (noeviction, so a full
# queue errors instead of dropping jobs) plus AOF-rewrite buffers and allocator overhead.
MEM_LIMIT_VALKEY=384m

# MEM_LIMIT_CADDY — the reverse proxy. Default: 256m (a few MB idle; TLS handshakes and HTTP/3 peak).
MEM_LIMIT_CADDY=256m

# MEM_LIMIT_BACKUP — the backup sidecar. Default: 1536m. Its tmpfs (BACKUP_TMPFS_SIZE) counts against
# this limit while a backup or restore test runs: keep it >= BACKUP_TMPFS_SIZE + 256m (preflight
# fails otherwise; without swap a backup that outgrows the limit is OOM-killed).
MEM_LIMIT_BACKUP=1536m

# MEM_LIMIT_PROMETHEUS / _GRAFANA / _LOKI / _ALLOY / _NODE_EXPORTER / _CADVISOR / _KUMA — the
# monitoring profile (only used when COMPOSE_PROFILES lists it). Defaults below; together ~2.9 GB
# as a ceiling, ~1 GB in practice on a small stack.
MEM_LIMIT_PROMETHEUS=512m
MEM_LIMIT_GRAFANA=768m
# GRAFANA_GOMEMLIMIT — the Go GC target inside Grafana; keep it at about half of MEM_LIMIT_GRAFANA. Default: 400MiB.
GRAFANA_GOMEMLIMIT=400MiB
MEM_LIMIT_LOKI=512m
MEM_LIMIT_ALLOY=384m
MEM_LIMIT_NODE_EXPORTER=128m
MEM_LIMIT_CADVISOR=256m
MEM_LIMIT_KUMA=384m

# ---------------------------------------------------------------------------------------------
# 4 EXECUTIONS — n8n defaults exposed as knobs (names verified in the 2.42 image)
# ---------------------------------------------------------------------------------------------

# EXECUTIONS_DATA_PRUNE — delete old execution data automatically. Default: true. Why: the
# executions table is the fastest-growing one; without pruning Postgres and backups balloon.
EXECUTIONS_DATA_PRUNE=true

# EXECUTIONS_DATA_MAX_AGE — hours to keep finished executions. Default: 336 (14 days).
EXECUTIONS_DATA_MAX_AGE=336

# EXECUTIONS_DATA_PRUNE_MAX_COUNT — hard cap on stored executions (oldest pruned first).
# Default: 10000. Why: bounds the table even when a trigger fires thousands of times per hour.
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# EXECUTIONS_DATA_SAVE_ON_SUCCESS — store data of successful executions: all | none.
# Default: all (debuggability); switch to none on very high-volume instances.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all

# EXECUTIONS_DATA_SAVE_ON_ERROR — store data of failed executions: all | none. Default: all.
EXECUTIONS_DATA_SAVE_ON_ERROR=all

# EXECUTIONS_DATA_SAVE_ON_PROGRESS — persist after every node (survives crashes mid-run, costs
# DB writes). Default: false.
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false

# EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS — keep data of manual (editor) test runs. Default: true.
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# EXECUTIONS_TIMEOUT — default per-workflow timeout in seconds, -1 = none. Default: -1.
# Why: workflows can set their own timeout up to EXECUTIONS_TIMEOUT_MAX.
EXECUTIONS_TIMEOUT=-1

# EXECUTIONS_TIMEOUT_MAX — the highest timeout a workflow may configure, seconds. Default: 3600.
EXECUTIONS_TIMEOUT_MAX=3600

# N8N_CONCURRENCY_PRODUCTION_LIMIT — global production concurrency cap; -1 = unlimited.
# Default: -1. Why: in queue mode any value other than -1 OVERRIDES --concurrency (WORKER_CONCURRENCY)
# on every worker (verified) — leave it at -1 and size workers with WORKER_CONCURRENCY.
N8N_CONCURRENCY_PRODUCTION_LIMIT=-1

# N8N_GRACEFUL_SHUTDOWN_TIMEOUT — seconds n8n waits for running executions on SIGTERM.
# Default: 30 (n8n default). Why: the compose stop_grace_period of the n8n services (40 s) is
# deliberately larger than this so Docker never SIGKILLs an execution that n8n would have finished.
N8N_GRACEFUL_SHUTDOWN_TIMEOUT=30

# ---------------------------------------------------------------------------------------------
# 5 SECURITY — opinionated hardening; every name verified in the 2.42 image
# ---------------------------------------------------------------------------------------------

# N8N_BLOCK_ENV_ACCESS_IN_NODE — Code/expression nodes cannot read process.env. Default: true
# (also the 2.x default; set explicitly because the docs table still claims false).
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES — nodes cannot read /home/node/.n8n (config, encryption key
# file, event logs). Default: true. Why: a Read File node must never leak the instance settings.
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true

# N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS — keep /home/node/.n8n/config at 0600. Default: true
# (2.x default; the n8n_data volume is shared by main/webhooks/workers, all uid 1000).
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# N8N_GIT_NODE_DISABLE_BARE_REPOS — the Git node refuses bare repositories (an RCE vector).
# Default: true (2.x default, pinned).
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# N8N_DIAGNOSTICS_ENABLED — anonymous telemetry to n8n.io. Default: false (self-hosted, private).
N8N_DIAGNOSTICS_ENABLED=false

# N8N_PERSONALIZATION_ENABLED — the onboarding questionnaire. Default: false.
N8N_PERSONALIZATION_ENABLED=false

# N8N_HIRING_BANNER_ENABLED — the "we're hiring" console banner. Default: false.
N8N_HIRING_BANNER_ENABLED=false

# N8N_TEMPLATES_ENABLED — the workflow template gallery (fetched from n8n.io). Default: true.
N8N_TEMPLATES_ENABLED=true

# N8N_VERSION_NOTIFICATIONS_ENABLED — "new version available" hint in the UI. Default: true
# (it only compares version numbers; upgrades still happen through versions.env + make pin).
N8N_VERSION_NOTIFICATIONS_ENABLED=true

# N8N_PUBLIC_API_DISABLED — disable the REST public API (/api/v1). Default: false (API stays on;
# it is protected by API keys and sits behind UI_PROTECT when that is on).
N8N_PUBLIC_API_DISABLED=false

# N8N_UNVERIFIED_PACKAGES_ENABLED — allow installing community packages that n8n has not verified. Default: false
# (= the n8n 3.0 default; 2.42 warns at startup when it is left unset). Set true only for a package you trust.
N8N_UNVERIFIED_PACKAGES_ENABLED=false

# NODES_EXCLUDE — JSON array of node types that may not be used. Default (= the 2.x built-in
# default) disables Execute Command and Local File Trigger, the two shell/filesystem nodes.
# Why set it at all: any value REPLACES the built-in list, so keep both entries when adding more.
# Keep the JSON on one line inside the single quotes: Compose reads the quoted value literally
# (identical to the unquoted form) and the quotes stop bash from eating the " characters when
# scripts/lib.sh load_env sources this file.
NODES_EXCLUDE='["n8n-nodes-base.executeCommand","n8n-nodes-base.localFileTrigger"]'

# Not exposed on purpose (contract §5):
# * N8N_RESTRICT_FILE_ACCESS_TO — left at its 2.x default /home/node/.n8n-files, which the kit
#   mounts as the dedicated n8n_files volume: that directory is the Read/Write Files node's whole
#   world. Do NOT point it inside /home/node/.n8n (blocked by N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES).
# * MFA enforcement — N8N_MFA_ENFORCED_ENABLED=true only takes effect together with
#   N8N_SECURITY_POLICY_MANAGED_BY_ENV=true, which hands the whole security policy to env vars.
#   Off by default; enable MFA per user in the UI, or add both keys here AND to the compose env
#   map (plain N8N_MFA_ENFORCED does not exist).

# ---------------------------------------------------------------------------------------------
# 6 BACKUPS — the backup sidecar (compose/backup/): nightly pg_dump + key bundle, encrypted with
# age to two recipients, copied to every target below; weekly automatic restore test.
# Commands: make backup-now · make backups · make restore BACKUP=latest · make restore-test
# ---------------------------------------------------------------------------------------------

# BACKUP_ENABLED — schedule the nightly backup and the weekly restore test. Default: true.
# false = nothing is scheduled (make backup-now still works) and make doctor warns about it.
BACKUP_ENABLED=true

# BACKUP_REMOTES — space-separated targets that ALL receive every backup (3-2-1 in one line).
#   /backups/local       compose/backups on this host (init sets it for dev domains)
#   /backups/external    BACKUP_LOCAL_PATH below (external disk / NAS mount)
#   r2:BUCKET/PATH       Cloudflare R2 (RCLONE_CONFIG_R2_* below; free egress — the demo default)
#   s3:BUCKET/PATH       AWS S3 (RCLONE_CONFIG_S3_* below)
# Nothing else is accepted (a typo like r2/bucket would write into the container and vanish).
# A backup only counts as successful when every target received it. Quote when listing several.
# Use a prefix of its own per stack: retention prunes every kit bundle under <target>/daily.
# Default: empty on production domains — set at least one off-host target before going live.
BACKUP_REMOTES=

# BACKUP_LOCAL_PATH — host directory (an external disk or NAS mount) that appears in the container
# as /backups/external. Default: empty (= compose/backups, i.e. NOT a second copy). Must exist and be
# empty or hold only kit backups (make up hands it to the backup container's uid) — a dedicated
# sub-directory such as /mnt/usb/n8n-backups, never $HOME or a system directory.
BACKUP_LOCAL_PATH=

# BACKUP_SCHEDULE / RESTORE_TEST_SCHEDULE — cron expressions in GENERIC_TIMEZONE. Single quotes
# are required (spaces; bash must be able to source this file). Defaults: 02:00 daily, Sunday 03:00.
BACKUP_SCHEDULE='0 2 * * *'
RESTORE_TEST_SCHEDULE='0 3 * * 0'

# BACKUP_RETENTION_DAILY_DAYS / BACKUP_RETENTION_MONTHLY_DAYS — how long daily/ and monthly/
# bundles are kept, in whole days >= 1 (the first daily backup of each UTC month is also copied to
# monthly/). manual/, pre-upgrade/ and pre-restore/ are never deleted automatically. Defaults: 30, 365.
BACKUP_RETENTION_DAILY_DAYS=30
BACKUP_RETENTION_MONTHLY_DAYS=365

# BACKUP_RETENTION_MIN_KEEP — retention never deletes the N newest bundles of daily/ or monthly/,
# whatever their age (a clock that jumps ahead must not empty a remote). Default: 7.
BACKUP_RETENTION_MIN_KEEP=7

# BACKUP_NOTIFY_SUCCESS — also send a Telegram message for successful backups/restore tests
# (failures are always sent when ALERT_TELEGRAM_* is set). Default: false.
BACKUP_NOTIFY_SUCCESS=false

# BACKUP_TMPFS_SIZE — RAM-backed scratch space of the backup container: the dump, the encrypted
# bundle and the restore-test database are built there. Default: 1g (dumps up to ~300 MB); size it
# to ~3x the dump and raise MEM_LIMIT_BACKUP with it. make doctor warns when it gets tight.
BACKUP_TMPFS_SIZE=1g

# RESTORE_TEST_MAX_AGE_HOURS — the weekly restore test fails when the newest bundle on any target is
# older than this (the nightly backup stopped working). Default: 26.
RESTORE_TEST_MAX_AGE_HOURS=26

# Cloudflare R2 (BACKUP_REMOTES "r2:bucket/path"): an R2 API token scoped to the bucket.
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=

# AWS S3 (BACKUP_REMOTES "s3:bucket/path"): an IAM user limited to that bucket.
RCLONE_CONFIG_S3_REGION=ap-southeast-1
RCLONE_CONFIG_S3_ACCESS_KEY_ID=
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=

# BACKUP_AGE_PUBLIC_KEY — age recipient (public key) the backups are encrypted to; the private
# half is secrets/age-key.txt. Default: empty; filled by init from `age-keygen`.
BACKUP_AGE_PUBLIC_KEY=

# BACKUP_AGE_RECOVERY_PUBLIC_KEY — second recipient: the RECOVERY key, whose private half
# (secrets/age-recovery-key.txt) belongs in a password manager, off the host. Default: empty;
# filled by init. Why: a lost host must not mean lost backups.
BACKUP_AGE_RECOVERY_PUBLIC_KEY=

# BACKUP_ALLOW_SINGLE_RECIPIENT — true lets backups run without a recovery key (host key only).
# Default: false — a backup only this host can decrypt is lost together with the host.
BACKUP_ALLOW_SINGLE_RECIPIENT=false

# ---------------------------------------------------------------------------------------------
# 7 MONITORING — Prometheus, Grafana (https://DOMAIN/grafana/), Loki + Alloy (logs), node-exporter,
# cAdvisor, alert rules -> Telegram; optional Uptime Kuma. Guide: docs/operations/monitoring.md
# ---------------------------------------------------------------------------------------------

# COMPOSE_PROFILES — Compose profiles to activate, comma-separated:
#   monitoring        Prometheus, Grafana, Loki, Alloy, node-exporter, cAdvisor (~1 GB RAM more)
#   monitoring,kuma   + Uptime Kuma at kuma.DOMAIN (set KUMA_ENABLED=on as well; preflight checks)
# Default: empty = core stack only. Why: profile-gated services are invisible to `make up`,
# `make status` and `compose config --services` until the profile is listed here.
COMPOSE_PROFILES=

# GRAFANA_ADMIN_USER — Grafana admin login. Default: admin. The password is GRAFANA_ADMIN_PASSWORD
# (group 2); both are applied when Grafana first creates its database.
GRAFANA_ADMIN_USER=admin

# PROM_RETENTION / PROM_RETENTION_SIZE — how long / how much Prometheus keeps (whichever is hit
# first). Defaults: 15d, 2GB.
PROM_RETENTION=15d
PROM_RETENTION_SIZE=2GB

# LOKI_RETENTION — how long Loki keeps the container logs. Default: 336h (14 days).
LOKI_RETENTION=336h

# ALERT_TELEGRAM_BOT_TOKEN — bot token (@BotFather) for every alert: the backup sidecar's failures
# and the Grafana alert rules. Default: empty = no alerts are SENT (Grafana still shows them).
# Looks like 123456789:AAH... — no $ or spaces, so plain is fine.
ALERT_TELEGRAM_BOT_TOKEN=

# ALERT_TELEGRAM_CHAT_ID — chat/channel id the alerts go to (group ids are negative: -100…).
# Default: empty. make up re-renders Grafana's contact point when these two change.
ALERT_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------------------------
# 8 LOCAL
# ---------------------------------------------------------------------------------------------

# COMPOSE_PROJECT_NAME — the Compose project (prefix of container, network and volume names).
# Default: n8nkit. Why: fixed so volumes are called n8nkit_pg_data etc. regardless of the checkout
# directory name, and so scripts find containers by label without hard-coding container names.
COMPOSE_PROJECT_NAME=n8nkit
