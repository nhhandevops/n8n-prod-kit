# kuma-on.caddy -- imported at the END of the Caddyfile (top level) when
# KUMA_ENABLED=on. Publishes Uptime Kuma (S6 monitoring profile, service
# `uptime-kuma` on the internal network) on its own hostname kuma.DOMAIN.
#
# TLS follows the main site's TLS_MODE: with `tls internal` Caddy mints the
# certificate itself; in acme / acme-staging mode kuma.DOMAIN MUST resolve
# publicly to this host, otherwise Caddy keeps retrying ACME for it
# (preflight.sh checks that DNS record when KUMA_ENABLED=on).
# The site address carries the published HTTPS port for the same reason as
# the main site (see the `http_port` comment in the Caddyfile). This file is
# a whole site block, so the multi-line rule of the Caddyfile header applies
# here as well.
kuma.{$DOMAIN}:{$HTTPS_PORT:443} {
	import security_headers
	import /etc/caddy/tls-{$TLS_MODE:acme}.caddy

	# Without its own `log` block Caddy puts this host into the server's
	# skip_hosts list and Kuma requests are never access-logged (verified).
	log {
		output stdout
		# request headers are dropped: n8n API keys (X-N8n-Api-Key) and user-chosen webhook auth headers would otherwise
		# be logged in clear text and kept by Loki (Caddy itself only redacts Authorization and Cookie)
		format filter {
			wrap json
			request>headers delete
		}
	}

	# Same reason as in the main site: the 502 Caddy generates while Kuma is
	# still starting must carry the security headers and no Server banner.
	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}"
	}

	# Uptime Kuma speaks HTTP + WebSocket (socket.io); reverse_proxy passes
	# the Upgrade handshake through transparently.
	# the same optional UI protection (IP allow-list + basic auth) as the n8n editor
	import /etc/caddy/ui-protect-{$UI_PROTECT:off}.caddy
	reverse_proxy uptime-kuma:3001
}
