    {
      "id": 9,
      "type": "timeseries",
      "title": "Bundle size",
      "description": "Steady growth = more executions/binary data in the database; keep BACKUP_TMPFS_SIZE about 3x the bundle",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
