    {
      "id": 4,
      "type": "stat",
      "title": "Load per CPU (1 min)",
      "description": "1-minute load divided by the CPU count: above 1 processes wait for a CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
