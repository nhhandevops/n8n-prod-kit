      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_load1 / scalar(count(node_cpu_seconds_total{mode=\"idle\"}))",
          "legendFormat": "",
          "instant": true
        }
