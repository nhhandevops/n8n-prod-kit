# --- secrets and local state (never commit) ---
compose/.env
compose/.env.*
compose/.restore.lock
compose/secrets/*
compose/backups/*
compose/.smoke/
compose/.upgrade/
# Assembled per run by tests/acme/run.sh (a copy of compose/caddy plus the test CA's root); the run deletes it,
# but an interrupted one must not leave a certificate staged for committing.
tests/acme/.state/
*.age
terraform.tfvars
*.tfstate
*.tfstate.*
.terraform/

# --- generated ---
compose/compose.scale.yml
compose/monitoring/prometheus/targets/*.json
compose/monitoring/grafana/provisioning/alerting/notifications.yml
site/

# --- tooling ---
.venv/
__pycache__/
.DS_Store
Thumbs.db

# --- keep ---
!*.example
!**/.gitkeep
